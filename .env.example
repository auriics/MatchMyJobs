# ========================================================
# AntiGravite Environment Configuration (Phase 1)
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Database (Primary)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antigravite?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/antigravite?schema=public"

# Redis Cache (Token session revocation & cache)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
# Generated secure random keys
JWT_ACCESS_SECRET="antigravite-super-secure-jwt-access-secret-key-32chars"
JWT_REFRESH_SECRET="antigravite-super-secure-jwt-refresh-secret-key-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 Storage (Avatars and Resumes)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="antigravite-uploads"
# Optional S3 endpoint for MinIO or localstack (e.g. http://localhost:9000)
# AWS_ENDPOINT=""

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:5173/auth/linkedin/callback"

# Web Client URL (for CORS and redirects)
CLIENT_URL="http://localhost:5173,http://localhost:3000"
